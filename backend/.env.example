APP_NAME=Định hướng nghề
API_V1_PREFIX=/api/v1
# Domain được phép gọi API từ trình duyệt. Mặc định (hoặc để trống): * = mọi domain.
# Muốn giới hạn: JSON hoặc danh sách cách nhau bởi dấu phẩy, không có dấu / cuối,
# vd. https://dinhhuong.example.com,http://localhost:5173
CORS_ORIGINS=*
# Origin công khai của API, không gồm /api/v1. Dùng khi nhập OpenAPI vào Postman/Bruno.
# Để trống thì /docs lấy đúng host đang mở.
# Local: http://127.0.0.1:3060
# Production: https://api.example.com
API_PUBLIC_URL=
PORT=3060

DB_HOST=103.226.249.128
DB_USER=huongnghiep
DB_PASSWORD=
DB_NAME=huongnghiep
DB_PORT=13306

SECRET_KEY=doi-secret-key-trong-moi-truong-that
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Số ngày giữ file log trong backend/logs
LOG_RETENTION_DAYS=14

# Dữ liệu tuyển sinh. Để trống backend tự tìm data_dh_json ở thư mục gốc
TAI_LIEU_DIR=data_dh_json
# Nguồn dữ liệu cho chat: database = đề án đã công bố trong CSDL (dats_tuyen_sinh..., mặc định); thu_muc = file trong TAI_LIEU_DIR
CHAT_NGUON_DU_LIEU=database
# Chế độ database: số giây giữ dữ liệu đã đọc trước khi đọc lại CSDL
CHAT_DB_CACHE_SECONDS=300

# Thư viện ảnh/video. Để trống thì lưu tại backend/thu_vien. Mặc định tối đa 100 MB/file.
THU_VIEN_DIR=
THU_VIEN_MAX_BYTES=104857600

# Google Gemini (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI ChatGPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Thời gian chờ phản hồi chat AI (giây)
CHAT_TIMEOUT_SECONDS=75

# Dung lượng JSON tuyển sinh mỗi lượt (ký tự), sau khi lọc/xếp hạng
CHAT_CONTEXT_MAX_CHARS=60000
CHAT_DETAIL_CONTEXT_MAX_CHARS=100000
CHAT_PLANNING_TIMEOUT_SECONDS=20
# Biên điểm chuẩn mỗi phía quanh điểm mục tiêu (ví dụ 28 -> từ 27 đến 29)
CHAT_SCORE_MARGIN=1.0
# Chat trừ token của thành viên sau mỗi lượt. true: hết token thì không hỏi được (mời nạp gói Token AI)
CHAT_YEU_CAU_TOKEN=false

# Webhook giao dịch ngân hàng (SePay): đặt cùng API key khai báo ở SePay, header "Authorization: Apikey <khóa>".
# Để trống thì /api/v1/webhook/giao-dich-ngan-hang KHÔNG xác thực (chỉ dùng cho hệ thống test):
# môi trường thật phải đặt khóa, nếu không ai cũng gửi được giao dịch giả để được cộng số dư.
WEBHOOK_NGAN_HANG_API_KEY=
