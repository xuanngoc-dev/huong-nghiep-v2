# ==========================================
# CẤU HÌNH THƯ MỤC DỮ LIỆU TUYỂN SINH
# ==========================================
# Để trống thì backend tự động nhận thư mục data_dh_json ở thư mục gốc
TAI_LIEU_DIR=data_dh_json

# ==========================================
# CẤU HÌNH GOOGLE GEMINI (Google AI Studio)
# Lấy API key tại: https://aistudio.google.com/app/apikey
# Model: gemini-3.5-flash-lite (mặc định), gemini-3.8-flash
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ==========================================
# CẤU HÌNH OPENAI CHATGPT (OpenAI API)
# Lấy API key tại: https://platform.openai.com/api-keys
# Model: gpt-6-luna (6.0 Luna mặc định), gpt-6-sol, gpt-5, o3-mini
# ==========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Thời gian chờ phản hồi chat AI (giây)
CHAT_TIMEOUT_SECONDS=75

# Dung lượng JSON tuyển sinh mỗi lượt (ký tự), sau khi lọc/xếp hạng
CHAT_CONTEXT_MAX_CHARS=60000
# Trần riêng cho yêu cầu đọc điều kiện/công thức chi tiết
CHAT_DETAIL_CONTEXT_MAX_CHARS=100000
# Thời gian tối đa cho AI hiểu hội thoại và lập kế hoạch tra cứu (trong timeout chung)
CHAT_PLANNING_TIMEOUT_SECONDS=20
