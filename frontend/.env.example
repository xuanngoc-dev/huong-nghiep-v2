# URL tuyệt đối của API backend, không có dấu / cuối.
# Remote: https://huongnghiepapi.dtsgroup.com.vn/api/v1
# Local:  http://127.0.0.1:3060/api/v1
VITE_API_BASE_URL=https://huongnghiepapi.dtsgroup.com.vn/api/v1

# Bật dark mode Element Plus
VITE_DARK_MODE=false

# ===== SEO & Quảng cáo (tùy chọn) =====
# URL tuyệt đối của website (không có dấu / cuối). Dùng để tạo og:image cho Facebook/Zalo/Ads.
# VITE_SITE_URL=https://ten-mien-cua-ban.vn
# Mã xác minh Google Search Console (chỉ phần content của thẻ meta).
# VITE_GOOGLE_SITE_VERIFICATION=
# Mã xác minh tên miền Facebook Business (bắt buộc khi chạy quảng cáo Meta).
# VITE_FACEBOOK_DOMAIN_VERIFICATION=
# Mã tài khoản Google AdSense, dạng ca-pub-xxxxxxxxxxxxxxxx.
# VITE_GOOGLE_ADSENSE_ACCOUNT=
# Facebook App ID (tùy chọn, cho Facebook Insights).
# VITE_FACEBOOK_APP_ID=
